{
  "name": "package-tripwire",
  "version": "1.1.1",
  "description": "Fail CI when dependency changes look suspicious: new install scripts, publisher/maintainer changes, freshly published versions, typosquats, deprecated packages, integrity swaps and git/URL deps. Diffs package-lock, pnpm and yarn lockfiles against a git ref or baseline. Text, JSON, SARIF; GitHub Action included.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "package-tripwire": "bin/package-tripwire.js"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "action.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "supply-chain-security",
    "npm",
    "lockfile",
    "dependencies",
    "security",
    "typosquatting",
    "install-scripts",
    "github-action",
    "sarif",
    "ci",
    "cli",
    "package-lock",
    "pnpm",
    "yarn",
    "malware",
    "provenance",
    "sigstore",
    "lockfile-lint",
    "allow-scripts"
  ],
  "author": "Louis Wright <hello@louiswright.co.uk> (https://github.com/MrLouisWright)",
  "license": "MIT",
  "funding": {
    "type": "stripe",
    "url": "https://donate.stripe.com/aFa00lek3cvX4Ds2Fk9EI0b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLouisWright/package-tripwire.git"
  },
  "bugs": {
    "url": "https://github.com/MrLouisWright/package-tripwire/issues"
  },
  "homepage": "https://mrlouiswright.github.io/package-tripwire/",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  }
}
